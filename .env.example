# 9router LLM Gateway Configuration (OpenAI Compatible)
NINEROUTER_API_KEY=your_api_key_here
NINEROUTER_BASE_URL=https://your-9router-url.com/v1
NINEROUTER_MODEL=ds/deepseek-chat

# Google AI / Gemini API Key (Fallback LLM provider)
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Earth Engine (GEE) Project Configuration
# Either provide your GCP Project ID with Earth Engine API enabled:
EE_PROJECT_ID=your_gcp_project_id_or_ee_project

# Optional: Path to Service Account JSON key (if not using local 'earthengine authenticate')
# EE_SERVICE_ACCOUNT_JSON=path/to/service_account_credentials.json

# Server Configuration
PORT=8088
HOST=127.0.0.1

